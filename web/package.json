{
  "name": "ilounge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "dev:sample": "astro dev --mode sample",
    "check": "astro check",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "build": "astro build",
    "build:sample": "astro build --mode sample --outDir dist-sample",
    "preview": "astro preview",
    "preview:sample": "astro preview --mode sample --outDir dist-sample"
  },
  "dependencies": {
    "@sanity/client": "8.9.0",
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
