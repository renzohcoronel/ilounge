---
import type { Landing } from '../lib/landing.ts';
import '../styles/global.css';

interface Props {
  seo: Landing['seo'];
  canonical: string;
  sample: boolean;
}

const { seo, canonical, sample } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {sample && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    {seo.shareImage && (
      <>
        <meta property="og:image" content={seo.shareImage.url} />
        <meta property="og:image:alt" content={seo.shareImage.alt} />
        <meta property="og:image:width" content={String(seo.shareImage.width)} />
        <meta property="og:image:height" content={String(seo.shareImage.height)} />
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
